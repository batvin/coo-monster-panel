#!/usr/bin/env bash
# Shortcut for the Coo Monster terminal control panel.
# Generated by deploy/install.sh. Do not edit this file directly.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    exec sudo "$0" "$@"
  fi
  echo "ERROR: run 'coo-monster' as root or install sudo." >&2
  exit 1
fi

exec bash "__APP_DIR__/deploy/panel.sh" "$@"

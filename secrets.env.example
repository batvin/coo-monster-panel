# The installer only asks for ADMIN_WEB_PASSWORD. Never commit this file.
# BOT_TOKEN and ADMIN_ID can be left empty and set later in coo-monster or the web panel.
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
ADMIN_ID=YOUR_NUMERIC_TELEGRAM_ID
ADMIN_WEB_PASSWORD=YOUR_STRONG_PASSWORD
# Optional SOCKS5 proxy used only for Telegram API calls.
# Format: socks5://user:pass@host:port  or  socks5://host:port
TELEGRAM_SOCKS5=
